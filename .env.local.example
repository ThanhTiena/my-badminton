# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-character-string-or-longer

# Vercel Blob token (for invoice image uploads)
# Get from: vercel.com/dashboard/stores → Blob → Token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx